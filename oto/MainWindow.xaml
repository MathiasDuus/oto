<Window x:Class="oto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:oto"
        Title="oto - Fastest AutoClicker" Height="200" Width="200"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Delay row -->
            <RowDefinition Height="Auto"/>
            <!-- Max Clicks toggle -->
            <RowDefinition Height="Auto"/>
            <!-- Clicks row -->
            <RowDefinition Height="Auto"/>
            <!-- Hotkey change -->
            <RowDefinition Height="Auto"/>
            <!-- Current hotkey display -->
            <RowDefinition Height="*"/>
            <!-- Spacer or status messages -->
        </Grid.RowDefinitions>

        <!-- Delay (ms) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="DelayBox" Width="80" Text="0" ToolTip="0 = no delay; -1 ≈ ~100 CPS; -2 ≈ ~200 CPS" />
        </StackPanel>

        <!-- Enable max clicks -->
        <CheckBox x:Name="EnableMaxClicks" Grid.Row="1" Content="Enable max clicks" Margin="0,0,0,10"/>

        <!-- Number of clicks -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Clicks:" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="ClicksBox" Width="80" Text="0" IsEnabled="False"/>
        </StackPanel>

        <!-- Hotkey change -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="To start/stop press:" VerticalAlignment="Center" Width="120"/>
            <TextBlock x:Name="CurrentHotkeyText" Text="F5" VerticalAlignment="Center" 
                   FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <!-- Change hotkey -->
        <Button Grid.Row="4" x:Name="ChangeHotkeyButton" Content="Change" Width="80" />

        <!-- Status / messages -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Text="" Foreground="Red" 
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>
