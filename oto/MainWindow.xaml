<Window x:Class="oto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:oto"
        Title="oto"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Width="220" Height="217" Icon="/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Delay row -->
            <RowDefinition Height="Auto"/>
            <!-- Max Clicks toggle -->
            <RowDefinition Height="Auto"/>
            <!-- Clicks row -->
            <RowDefinition Height="Auto"/>
            <!-- Hotkey change -->
            <RowDefinition Height="Auto"/>
            <!-- Current hotkey display -->
            <RowDefinition Height="Auto"/>
            <!-- Spacer or status messages -->
        </Grid.RowDefinitions>

        <!-- Delay (ms) -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Width="100"/>
            <xctk:IntegerUpDown x:Name="DelayBox" Width="80" Margin="0,5,0,0" Minimum="0" Value="0" />

        </StackPanel>

        <!-- Enable max clicks -->
        <CheckBox x:Name="EnableMaxClicks" Grid.Row="1" Content="Enable max clicks" Margin="0,0,0,10"/>

        <!-- Number of clicks -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Clicks:" VerticalAlignment="Center" Width="100"/>
            <xctk:IntegerUpDown x:Name="ClicksBox" Width="80" Margin="0,5,0,0" Minimum="0" Value="0" IsEnabled="False" />
        </StackPanel>

        <!-- Hotkey change -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="To start/stop press:" VerticalAlignment="Center" Width="105"/>
            <Button x:Name="ChangeHotkeyButton" Content="Change" Width="80" />
        </StackPanel>

        <!-- Change hotkey -->
        <TextBlock Grid.Row="4" x:Name="CurrentHotkeyText" Text="F5" VerticalAlignment="Center" 
                   HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>

        <!-- Status / messages -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Text="" Foreground="Red" 
                   HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Grid>
</Window>
